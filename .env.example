# Required — Anthropic API key for Claude agent calls
ANTHROPIC_API_KEY=

# Required — API key for endpoint authentication (X-API-Key header)
APP_API_KEY=

# Required — Separate key for admin endpoints (POST /apis/refresh)
ADMIN_API_KEY=

# Environment: development | production
# Controls CORS defaults and debug behavior
ENV=development

# CORS allowed origins (JSON array)
# Defaults to ["*"] in development, [] in production
CORS_ALLOWED_ORIGINS=["*"]

# Max characters per chat message
MAX_MESSAGE_LENGTH=10000

# Session TTL in seconds (default: 2 hours)
SESSION_TTL_SECONDS=7200

# Maximum concurrent sessions
MAX_SESSIONS=1000

# Maximum messages per session
MAX_MESSAGES_PER_SESSION=200

# Max tokens per agent call
MAX_TOKENS_PER_CALL=4096

# Max total tokens per session lifetime
SESSION_TOKEN_BUDGET=50000

# Rate limit: max chat requests per minute
CHAT_RATE_LIMIT_PER_MIN=60

# Max doc file size in bytes (default: 1 MB)
MAX_DOC_FILE_SIZE_BYTES=1048576

# Path to API documentation directory
MARKETPLACE_APIS_DIR=marketplace_apis
